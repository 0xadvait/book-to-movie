# Copy to .env (setup.sh does it for you). .env is git-ignored. Keys are only ever read from here or your environment.
# Everything works with both empty: the voice falls back to your computer's free one, and effects are skipped.

# Narration and sound effects through fal (https://fal.ai). Recommended: about $1 per ten minutes of film.
FAL_KEY=

# Or narration straight from ElevenLabs on your own plan (https://elevenlabs.io).
ELEVENLABS_API_KEY=
